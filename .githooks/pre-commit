#!/bin/bash
# Blocks commits of bot-generated files that have a local/ source.
# These files must only be committed by scheduled CI workflows with real API credentials.
# A local/ source means the generator ran without API access and fell back to disk cache —
# the live site discards local/ sources and shows "No game today."

STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -q "public/data/sample-game.json"; then
  SOURCE=$(git show :public/data/sample-game.json 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); g=d.get('games',[]); s=g[0].get('canonicalGameSource',{}).get('source','') if g else ''; print(s)" 2>/dev/null)
  if [[ "$SOURCE" == local/* ]]; then
    echo ""
    echo "COMMIT BLOCKED: sample-game.json has source \"$SOURCE\""
    echo ""
    echo "This file was generated by a local bot run without API credentials."
    echo "Committing it deploys broken data — the live site discards local/ sources"
    echo "and shows \"No game today.\""
    echo ""
    echo "Unstage it:  git restore --staged public/data/sample-game.json"
    echo "Bot CI will update it automatically on the next scheduled run."
    echo ""
    exit 1
  fi
fi

exit 0
